{
  "productName": "POTATO",
  "version": "0.21.0",
  "identifier": "com.potato.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "POTATO",
        "width": 1200,
        "height": 750,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 500,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.github.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "section": "editors"
      }
    }
  }
}
